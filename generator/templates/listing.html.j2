<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brief.title }}</title>
<meta name="description" content="{{ brief.meta_description }}">
<link rel="canonical" href="{{ opp.proposed_url }}">
<script type="application/ld+json">{{ jsonld | tojson }}</script>
<style>
  :root {
    --brand: #0f9d58; --brand-dark: #0b7a44; --ink: #1f2933; --muted: #616e7c; --line: #e4e7eb;
    --bg: #f5f7fa; --card: #fff; --accent: #fff4e5; --radius: 8px;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: var(--bg); }
  a { color: var(--brand-dark); }
  .topbar { background: #fff; border-bottom: 1px solid var(--line); }
  .topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { font-weight: 800; font-size: 22px; color: var(--brand); letter-spacing: -.5px; text-decoration: none; }
  .topbar nav a { margin-left: 20px; color: var(--muted); text-decoration: none; font-size: 14px; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .crumbs { font-size: 13px; color: var(--muted); padding: 14px 0 0; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs span { margin: 0 6px; }
  .hero h1 { font-size: 28px; line-height: 1.25; margin: 10px 0 4px; }
  .hero .sub { color: var(--muted); margin: 0 0 16px; }
  .answer { background: var(--accent); border-left: 4px solid #f59e0b; border-radius: var(--radius); padding: 14px 16px; margin-bottom: 20px; }
  .answer strong { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #b45309; margin-bottom: 4px; }
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 24px; align-items: start; }
  aside { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; position: sticky; top: 12px; }
  aside h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 8px; }
  aside .opt { display: flex; gap: 8px; align-items: center; font-size: 14px; margin: 6px 0; }
  aside .opt input { accent-color: var(--brand); }
  aside hr { border: 0; border-top: 1px solid var(--line); margin: 14px 0; }
  .card { display: grid; grid-template-columns: 200px minmax(0, 1fr) auto; gap: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; margin-bottom: 14px; }
  .thumb { border-radius: 6px; min-height: 140px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 30px; font-weight: 700; background: linear-gradient(135deg, #34d399, #0f766e); }
  .card h2 { font-size: 18px; margin: 0 0 2px; }
  .card h2 a { color: var(--ink); text-decoration: none; }
  .loc { color: var(--muted); font-size: 14px; margin: 0 0 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .chips li { font-size: 12px; background: #eef2f7; border-radius: 99px; padding: 3px 10px; }
  .chips li.hit { background: #dcfce7; color: #166534; font-weight: 600; }
  .side { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; min-width: 140px; }
  .rating { background: var(--brand); color: #fff; font-weight: 700; border-radius: 4px; padding: 2px 8px; font-size: 14px; }
  .rating.none { background: #cbd2d9; color: var(--ink); font-weight: 500; }
  .price { font-size: 13px; color: var(--muted); text-align: right; }
  .price .amt { display: block; font-size: 20px; color: var(--ink); }
  .book { display: inline-block; background: #e53935; color: #fff; text-decoration: none; font-weight: 700; padding: 10px 18px; border-radius: 6px; text-align: center; }
  .book:hover { background: #c62828; }
  section.block { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; margin: 20px 0; }
  section.block h2 { font-size: 20px; margin: 0 0 10px; }
  .table-scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { border-bottom: 1px solid var(--line); padding: 8px 10px; text-align: left; white-space: nowrap; }
  th { background: #f8fafc; font-weight: 600; }
  td.yes { color: var(--brand-dark); font-weight: 700; }
  td.no { color: #9aa5b1; }
  details.faq { border-bottom: 1px solid var(--line); padding: 12px 0; }
  details.faq summary { cursor: pointer; font-weight: 600; list-style: none; }
  details.faq summary::after { content: "+"; float: right; color: var(--muted); }
  details.faq[open] summary::after { content: "–"; }
  details.faq p { margin: 8px 0 0; color: #3e4c59; }
  .links { columns: 2; padding-left: 18px; margin: 0; }
  .links li { margin: 4px 0; }
  footer { color: var(--muted); font-size: 13px; padding: 24px 0 40px; text-align: center; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    aside { position: static; }
    .card { grid-template-columns: minmax(0, 1fr); }
    .thumb { min-height: 120px; }
    .side { flex-direction: row; align-items: center; }
    .hero h1 { font-size: 22px; }
    .topbar nav { display: none; }
    .links { columns: 1; }
  }
</style>
</head>
<body>
<header class="topbar"><div class="wrap">
  <a class="logo" href="https://www.treebo.com/">treebo</a>
  <nav><a href="https://www.treebo.com/hotels-in-{{ city_slug }}/">Hotels in {{ opp.city }}</a><a href="https://www.treebo.com/faq/">Help</a></nav>
</div></header>

<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb">
    {% for crumb in breadcrumbs %}{% if not loop.last %}<a href="{{ crumb.url }}">{{ crumb.name }}</a><span>›</span>{% else %}{{ crumb.name }}{% endif %}{% endfor %}
  </nav>

  <div class="hero">
    <h1>{{ brief.h1 }}</h1>
    <p class="sub">{{ hotels | length }} Treebo hotels · sorted by guest rating</p>
  </div>

  <div class="answer" data-claims="quick_answer"><strong>Quick answer</strong>{{ brief.quick_answer }}</div>

  <div class="layout">
    <aside>
      <h3>Sort by</h3>
      <label class="opt"><input type="radio" name="sort" checked disabled> Guest rating</label>
      <label class="opt"><input type="radio" name="sort" disabled> Popularity</label>
      <hr>
      <h3>Filters</h3>
      <label class="opt"><input type="checkbox" checked disabled> {{ filter_label }}</label>
      {% for a in compare %}<label class="opt"><input type="checkbox" disabled> {{ a.label }}</label>{% endfor %}
    </aside>

    <div>
      {% for h in hotels %}
      <article class="card">
        <div class="thumb" aria-hidden="true">{{ h.initials }}</div>
        <div>
          <h2><a href="{{ h.url }}">{{ h.name }}</a></h2>
          <p class="loc">{{ h.locality }}, {{ h.city }}</p>
          <ul class="chips">
            {% for chip in h.chips %}<li class="{{ 'hit' if chip.hit }}">{{ chip.label }}</li>{% endfor %}
          </ul>
        </div>
        <div class="side">
          {% if h.rating %}<span class="rating">{{ h.rating }} / 5</span>{% else %}<span class="rating none">Not rated</span>{% endif %}
          <div>
            {% if h.price %}<p class="price"><b class="amt">{{ h.price }}</b> onwards{% if h.price_as_of %}<br><small>as of {{ h.price_as_of }}</small>{% endif %}</p>
            {% else %}<p class="price">See today's price</p>{% endif %}
            <a class="book" href="{{ h.url }}">Book Now</a>
          </div>
        </div>
      </article>
      {% endfor %}

      <section class="block">
        <h2>Why stay in {{ opp.place }}</h2>
        <p data-claims="about_area">{{ about_area }}</p>
      </section>

      <section class="block">
        <h2>Quick facts</h2>
        <div class="table-scroll"><table>
          <thead><tr><th>Hotel</th><th>Locality</th><th>Rating</th><th>{{ filter_label }}</th>{% for a in compare %}<th>{{ a.label }}</th>{% endfor %}</tr></thead>
          <tbody>
          {% for h in hotels %}
            <tr><td>{{ h.name }}</td><td>{{ h.locality }}</td><td>{{ h.rating or "–" }}</td><td class="yes">✓</td>
            {% for a in compare %}{% if a.slug in h.amenities %}<td class="yes">✓</td>{% else %}<td class="no">–</td>{% endif %}{% endfor %}</tr>
          {% endfor %}
          </tbody>
        </table></div>
      </section>

      <section class="block">
        <h2>Frequently asked questions</h2>
        {% for f in brief.faqs %}
        <details class="faq"{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
        {% endfor %}
      </section>

      <section class="block">
        <h2>Explore nearby</h2>
        <ul class="links">
          {% for link in links %}<li><a href="{{ link.url }}">{{ link.text }}</a></li>{% endfor %}
        </ul>
      </section>
    </div>
  </div>
</main>
<footer>Preview generated by the Treebo AEO agent · hotel details from Treebo inventory</footer>
</body>
</html>
